{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart: rank of Australia's largest overseas-born communities in 2015 versus 2025.",
  "width": 720,
  "height": 560,
  "data": {
    "url": "data/chart2_slope_country_of_birth_2015_2025.csv"
  },
  "transform": [
    {
      "calculate": "datum.year == 2015 ? datum.rank_in_year : null",
      "as": "r15"
    },
    {
      "calculate": "datum.year == 2025 ? datum.rank_in_year : null",
      "as": "r25"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "r15",
          "as": "rank2015"
        },
        {
          "op": "max",
          "field": "r25",
          "as": "rank2025"
        }
      ],
      "groupby": [
        "country_of_birth"
      ]
    },
    {
      "calculate": "datum.rank2025 < datum.rank2015 ? 'Moved up the ranking' : (datum.rank2025 > datum.rank2015 ? 'Moved down the ranking' : 'Same rank')",
      "as": "trend"
    },
    {
      "calculate": "(datum.pct_change_2015_2025 > 0 ? '+' : '') + format(datum.pct_change_2015_2025, '.0f') + '%'",
      "as": "pct_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "scale": {
            "padding": 1
          },
          "axis": {
            "orient": "top",
            "title": null,
            "labelFontSize": 18,
            "labelFontWeight": "bold",
            "labelAngle": 0,
            "labelLimit": 100,
            "domain": false,
            "ticks": false,
            "labelPadding": 8,
            "grid": false
          }
        },
        "y": {
          "field": "rank_in_year",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              32
            ],
            "reverse": true
          }
        },
        "color": {
          "field": "trend",
          "type": "nominal",
          "scale": {
            "domain": [
              "Moved up the ranking",
              "Moved down the ranking",
              "Same rank"
            ],
            "range": [
              "#1F7A6D",
              "#C2452F",
              "#8A8A8A"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "direction": "horizontal",
            "columns": 3,
            "columnPadding": 40,
            "labelFontSize": 13,
            "labelLimit": 240
          }
        },
        "detail": {
          "field": "country_of_birth",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "scale": {
            "padding": 1
          },
          "axis": {
            "orient": "top",
            "title": null,
            "labelFontSize": 18,
            "labelFontWeight": "bold",
            "labelAngle": 0,
            "labelLimit": 100,
            "domain": false,
            "ticks": false,
            "labelPadding": 8,
            "grid": false
          }
        },
        "y": {
          "field": "rank_in_year",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              32
            ],
            "reverse": true
          }
        },
        "color": {
          "field": "trend",
          "type": "nominal",
          "scale": {
            "domain": [
              "Moved up the ranking",
              "Moved down the ranking",
              "Same rank"
            ],
            "range": [
              "#1F7A6D",
              "#C2452F",
              "#8A8A8A"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "direction": "horizontal",
            "columns": 3,
            "columnPadding": 40,
            "labelFontSize": 13,
            "labelLimit": 240
          }
        },
        "tooltip": [
          {
            "field": "country_of_birth",
            "type": "nominal",
            "title": "Country of birth"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "rank_in_year",
            "type": "quantitative",
            "title": "Rank among overseas-born"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "People",
            "format": ","
          },
          {
            "field": "change_2015_2025",
            "type": "quantitative",
            "title": "Change 2015 to 2025",
            "format": "+,"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2015"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontSize": 14,
        "color": "#2B2A28"
      },
      "encoding": {
