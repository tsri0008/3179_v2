{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph: people arriving to settle in Australia each year by region, 1947 to 2016.",
  "width": 780,
  "height": 440,
  "data": {
    "url": "data/chart3_streamgraph_arrivals_by_region_1945_2017.csv"
  },
  "transform": [
    {
      "filter": "lower(toString(datum.partial_period)) != 'true' && datum.region != 'Not stated / other'"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "calculate": "indexof([\"Europe\", \"Middle East & North Africa\", \"Sub-Saharan Africa\", \"Americas\", \"Oceania\", \"Asia\"], datum.region)",
          "as": "ord"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "year_start",
          "type": "quantitative",
          "title": "Year (financial year starting July)",
          "axis": {
            "format": "d",
            "values": [
              1950,
              1960,
              1970,
              1980,
              1990,
              2000,
              2010
            ],
            "grid": false,
            "labelFontSize": 13,
            "titleFontSize": 13
          },
          "scale": {
            "domain": [
              1947,
              2016
            ],
            "nice": false
          }
        },
        "y": {
          "field": "persons",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "scale": {
            "domain": [
              "Europe",
              "Middle East & North Africa",
              "Sub-Saharan Africa",
              "Americas",
              "Oceania",
              "Asia"
            ],
            "range": [
              "#3B6FB6",
              "#B5495B",
              "#7A9A3F",
              "#8E6BB0",
              "#5FA8A0",
              "#E8A33D"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "direction": "horizontal",
            "columns": 3,
            "columnPadding": 52,
            "rowPadding": 4,
            "labelFontSize": 13,
            "labelLimit": 240
          }
        },
        "order": {
          "field": "ord",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1959
          },
          {
            "x": 1996
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "color": "#555",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1959
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "y": 14,
        "fontSize": 12,
        "color": "#6B675E",
        "text": "1959: counted by country of birth"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1996
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -5,
        "y": 14,
        "fontSize": 12,
        "color": "#6B675E",
        "text": "1996: now ‘permanent additions’ ▸"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 4,
        "y": 14,
        "align": "left",
        "fontSize": 12,
        "color": "#6B675E",
        "text": "By last residence"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 118,
        "y": 78,
        "align": "center",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#3B6FB6",
        "text": [
          "1950s–60s: about 9 in 10",
          "arrivals came from Europe"
        ],
        "lineHeight": 16
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 420,
        "y": 86,
        "align": "center",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#B07A1C",
        "text": [
          "1983–84: Asia overtakes",
          "Europe for the first time"
        ],
        "lineHeight": 16
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "x": 776,
        "y": 14,
        "align": "right",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#2B2A28",
        "text": [
          "Peak: 246,000 people in 2012–13"
        ],
        "lineHeight": 16
      }
    },
    {
      "transform": [
        {
          "pivot": "region",
          "value": "persons",
          "groupby": [
            "year_start"
          ]
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year_start"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#222",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year_start",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.7
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "year_start",
            "type": "quantitative",
            "title": "Year starting",
            "format": "d"
          },
          {
            "field": "Europe",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Middle East & North Africa",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Sub-Saharan Africa",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Americas",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Oceania",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Asia",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    }
  ]
}